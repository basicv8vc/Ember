# Ember local development environment (P0B-01)
#
# Copy this file to `.env.local` and adjust values as needed:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Do not put production credentials here.
# Everything below points at the local Docker Compose database only.

# Runtime mode: local | test | ci
EMBER_ENV=local

# HTTP listener. Keep loopback in local development.
# Binding a non-loopback host additionally requires EMBER_ALLOW_NON_LOOPBACK_BIND=true.
EMBER_HOST=127.0.0.1
EMBER_PORT=8787
EMBER_LOG_LEVEL=info

# B1 Session sign-in for an isolated loopback development setup.
# Apple verification is still configured and used for Apple sessions; this bundle id is public.
EMBER_APPLE_BUNDLE_ID=com.ember.mobile
# Dev identity sign-in is only available on an actual loopback listener in local/test/CI.
EMBER_DEV_PROVIDER_ENABLED=true
EMBER_DEV_PROVIDER_ISOLATED=true

# Application database (used by `pnpm dev`, `pnpm db:migrate`)
DATABASE_URL=postgres://ember:ember_local_dev_only@127.0.0.1:55432/ember

# Dedicated database for integration tests (created by infra/local/initdb).
# Tests only create/drop their own uniquely named schema inside it.
TEST_DATABASE_URL=postgres://ember:ember_local_dev_only@127.0.0.1:55432/ember_test

# Optional: dedicated privileged role for the one fixture that provisions a throwaway login
# (`tests/integration/http-task-sse.test.ts`, which needs CREATEROLE). Keeping it separate means
# the ordinary test role stays unprivileged. When unset, role DDL falls back to TEST_DATABASE_URL.
# Provision it once:
#   CREATE ROLE ember_test_admin LOGIN CREATEROLE PASSWORD '<password>';
#   GRANT ember TO ember_test_admin;  -- lets it grant on objects owned by `ember`
# TEST_ADMIN_DATABASE_URL=postgres://ember_test_admin:<password>@127.0.0.1:55432/ember_test

# Local dev authentication credentials (P0B-07a).
# The API maps presented Bearer tokens to a verified AuthContext. Configure at least slot A
# to authorize `/v1` requests. Configure slot B to test cross-tenant isolation locally.
# Tokens must contain 16-256 base64url characters (A-Za-z0-9._~+/=-).
# EMBER_DEV_AUTH_TENANT_A_TOKEN=dev-token-alpha-local-32bytes-secret
# EMBER_DEV_AUTH_TENANT_A_TENANT_ID=11111111-1111-1111-1111-111111111111
# EMBER_DEV_AUTH_TENANT_A_PRINCIPAL_ID=11111111-1111-1111-1111-111111111112
# EMBER_DEV_AUTH_TENANT_A_POLICY_VERSION=1
# EMBER_DEV_AUTH_TENANT_B_TOKEN=dev-token-bravo-local-32bytes-secret
# EMBER_DEV_AUTH_TENANT_B_TENANT_ID=22222222-2222-2222-2222-222222222222
# EMBER_DEV_AUTH_TENANT_B_PRINCIPAL_ID=22222222-2222-2222-2222-222222222223
# EMBER_DEV_AUTH_TENANT_B_POLICY_VERSION=1

# Worker process settings (P0B-04 / P0B-05 / P0B-06 / P0B-10).
# In local development, `pnpm dev` starts both API and Worker concurrently in parallel.
# You can also start them individually with `pnpm dev:api` and `pnpm dev:worker`.
# By default, Worker runs in `reaper-only` mode (cleans expired leases, never claims tasks).
# To enable task execution locally, you MUST explicitly opt in to simulated execution:
#   EMBER_WORKER_MODE=poll
#   EMBER_WORKER_SIMULATED_EXECUTION=local-only
# Note: EMBER_WORKER_MODE=poll is strictly refused if EMBER_ENV=production or if
# EMBER_WORKER_SIMULATED_EXECUTION is not set to local-only.
EMBER_WORKER_MODE=reaper-only
EMBER_WORKER_ID=worker-local
EMBER_WORKER_INTERVAL_MS=2000
EMBER_WORKER_ERROR_BACKOFF_MS=1000
EMBER_WORKER_LEASE_MS=30000
EMBER_WORKER_HEARTBEAT_MS=10000
EMBER_WORKER_RETRY_BASE_MS=1000
EMBER_WORKER_RETRY_CAP_MS=30000
EMBER_WORKER_REAPER_BATCH=50

# B1 Cloud Chat deterministic responder. Defaults to disabled in the Worker itself; set true
# only for isolated local/test/CI environments. Production activation fails at startup.
EMBER_B1_FAKE_RESPONDER_ENABLED=false

# B2 model execution. `disabled` is the default in every environment, including production.
#   disabled  no model responder at all (default)
#   fake      zero-cost, zero-egress, visibly simulated; refused in production/staging
#   real      paid provider calls; requires ALL of: an approved provider, a model id listed in
#             `APPROVED_REAL_MODELS` (empty in this tree), an `official_price_verified` or
#             `invoice_verified` rate row for that exact id, and a usable credential. Official
#             pricing must be reviewed before the first call; reconcile provider billing afterward.
#             No environment variable can satisfy gates 2 and 3, so enabling real is a reviewed
#             code change, not a config flip.
# See docs/product/B2_MODEL_TURN_IMPLEMENTATION.md §7 for the full enablement checklist.
# EMBER_MODEL_EXECUTION=disabled
# EMBER_MODEL_PROVIDER=openai|openrouter
# EMBER_MODEL_ID=<exact provider model ID, CTO approved; for OpenRouter e.g. openai/gpt-5.6-luna>
# EMBER_MODEL_API_KEY=<secret store only; never commit, never put in .env.local>
# EMBER_MODEL_TURN_LEASE_MS=30000
# EMBER_MODEL_ATTEMPT_TIMEOUT_MS=20000
# EMBER_MODEL_MAX_ATTEMPTS=2
#
# B2 money ceilings in micro-USD (1 USD = 1_000_000). These are implementation design values,
# not a spend authorisation, and they can only be lowered: the database enforces the same
# absolute ceilings, and principal <= tenant <= global.
# EMBER_MODEL_BUDGET_PER_ATTEMPT_MICRO_USD=5000
# EMBER_MODEL_BUDGET_PRINCIPAL_DAILY_MICRO_USD=250000
# EMBER_MODEL_BUDGET_TENANT_DAILY_MICRO_USD=1000000
# EMBER_MODEL_BUDGET_GLOBAL_DAILY_MICRO_USD=5000000
# EMBER_MODEL_BUDGET_PRINCIPAL_DAILY_TURNS=60

# P0B-06 durable worker: absolute path of the controlled blob root. When set, the worker
# commits Artifacts, Step checkpoints, the Workspace version and the terminal Run state in one
# fenced transaction. Leave it unset to keep the in-memory P0B-05 simulation only.
# To run full durable worker in local dev:
#   EMBER_WORKER_BLOB_ROOT=/tmp/ember-blobs
#   EMBER_WORKER_SIMULATED_EXECUTION=local-only
#   EMBER_WORKER_MODE=poll

# P0B-08b budget policy (trusted Worker configuration, never a Task payload field).
# Every limit is a non-negative safe integer and `0` is a legal, explicit, fail-closed value:
# it denies every step that would consume that dimension. The defaults below are the reviewed
# simulated policy for this build.
# EMBER_WORKER_BUDGET_POLICY_ID=p0b08b-simulated-v1
# EMBER_WORKER_BUDGET_POLICY_VERSION=1
# EMBER_WORKER_BUDGET_MAX_RUN_STEPS=8
# EMBER_WORKER_BUDGET_MAX_RUN_UNITS=100
# EMBER_WORKER_BUDGET_MAX_RUN_ELAPSED_MS=120000
# EMBER_WORKER_BUDGET_MAX_TENANT_DAILY_UNITS=5000
# EMBER_WORKER_BUDGET_MAX_CONCURRENT_SLOTS=8
