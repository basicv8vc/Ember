# Ember local development environment (P0B-01)
#
# Copy this file to `.env.local` and adjust values as needed:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Do not put production credentials here.
# Everything below points at the local Docker Compose database only.

# Runtime mode: local | test | ci
EMBER_ENV=local

# HTTP listener. Keep loopback in local development.
# Binding a non-loopback host additionally requires EMBER_ALLOW_NON_LOOPBACK_BIND=true.
EMBER_HOST=127.0.0.1
EMBER_PORT=8787
EMBER_LOG_LEVEL=info

# Application database (used by `pnpm dev`, `pnpm db:migrate`)
DATABASE_URL=postgres://ember:ember_local_dev_only@127.0.0.1:55432/ember

# Dedicated database for integration tests (created by infra/local/initdb).
# Tests only create/drop their own uniquely named schema inside it.
TEST_DATABASE_URL=postgres://ember:ember_local_dev_only@127.0.0.1:55432/ember_test
