# Ember local development environment (P0B-01)
#
# Copy this file to `.env.local` and adjust values as needed:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Do not put production credentials here.
# Everything below points at the local Docker Compose database only.

# Runtime mode: local | test | ci
EMBER_ENV=local

# HTTP listener. Keep loopback in local development.
# Binding a non-loopback host additionally requires EMBER_ALLOW_NON_LOOPBACK_BIND=true.
EMBER_HOST=127.0.0.1
EMBER_PORT=8787
EMBER_LOG_LEVEL=info

# Application database (used by `pnpm dev`, `pnpm db:migrate`)
DATABASE_URL=postgres://ember:ember_local_dev_only@127.0.0.1:55432/ember

# Dedicated database for integration tests (created by infra/local/initdb).
# Tests only create/drop their own uniquely named schema inside it.
TEST_DATABASE_URL=postgres://ember:ember_local_dev_only@127.0.0.1:55432/ember_test


# P0B-04 worker (reaper-only). It never claims or executes Tasks until P0B-05.
# `EMBER_WORKER_MODE=poll` is intentionally refused by the production entry point.
EMBER_WORKER_MODE=reaper-only
EMBER_WORKER_ID=worker-local
EMBER_WORKER_INTERVAL_MS=2000
EMBER_WORKER_ERROR_BACKOFF_MS=1000
EMBER_WORKER_LEASE_MS=30000
EMBER_WORKER_HEARTBEAT_MS=10000
EMBER_WORKER_RETRY_BASE_MS=1000
EMBER_WORKER_RETRY_CAP_MS=30000
EMBER_WORKER_REAPER_BATCH=50

# P0B-06 durable worker: absolute path of the controlled blob root. When set, the worker
# commits Artifacts, Step checkpoints, the Workspace version and the terminal Run state in one
# fenced transaction. Leave it unset to keep the in-memory P0B-05 simulation only.
# EMBER_WORKER_BLOB_ROOT=/var/lib/ember/blobs
# EMBER_WORKER_SIMULATED_EXECUTION=local-only
# EMBER_WORKER_MODE=poll

# P0B-08b budget policy (trusted Worker configuration, never a Task payload field).
# Every limit is a non-negative safe integer and `0` is a legal, explicit, fail-closed value:
# it denies every step that would consume that dimension. The defaults below are the reviewed
# simulated policy for this build.
# EMBER_WORKER_BUDGET_POLICY_ID=p0b08b-simulated-v1
# EMBER_WORKER_BUDGET_POLICY_VERSION=1
# EMBER_WORKER_BUDGET_MAX_RUN_STEPS=8
# EMBER_WORKER_BUDGET_MAX_RUN_UNITS=100
# EMBER_WORKER_BUDGET_MAX_RUN_ELAPSED_MS=120000
# EMBER_WORKER_BUDGET_MAX_TENANT_DAILY_UNITS=5000
# EMBER_WORKER_BUDGET_MAX_CONCURRENT_SLOTS=8
