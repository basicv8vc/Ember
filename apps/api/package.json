{
  "name": "@ember/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev:worker": "wrangler dev --config wrangler.local-v2.jsonc",
    "build:v2-staging": "wrangler deploy --dry-run --config wrangler.v2-staging.jsonc",
    "deploy:v2-staging": "node ../../infra/cloudflare/v2-staging-preflight.mjs --require-provisioned && wrangler deploy --config wrangler.v2-staging.jsonc"
  },
  "dependencies": {
    "@ember/contracts": "workspace:*",
    "@ember/domain": "workspace:*",
    "@ember/model-gateway": "workspace:*",
    "@ember/runtime-v2": "workspace:*",
    "@ember/sandbox-daytona": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "jose": "6.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "wrangler": "4.158.0"
  }
}
