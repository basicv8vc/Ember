{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Isolated V2 staging configuration for local dry-run validation and post-approval rollout.
  // Do NOT deploy without explicit CTO/Owner approval and provisioned D1/Queue resources.
  "name": "ember-v2-staging",
  "main": "src/local-v2/runtime-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ember-v2-staging.slowfast.dev",
      "custom_domain": true,
    },
  ],
  "observability": { "enabled": true },
  "vars": {
    "EMBER_ENV": "v2-staging",
    "EMBER_MODEL_MODE": "fake",
    "EMBER_V2_STAGING_ISOLATED": "true",
    "EMBER_V2_ALLOWED_HOST": "ember-v2-staging.slowfast.dev",
    "EMBER_APPLE_BUNDLE_ID": "com.basicv8vc.ember",
    "EMBER_APPLE_CLOCK_SKEW_SECONDS": "300",
    "EMBER_APPLE_MAX_TOKEN_AGE_SECONDS": "600",
    "EMBER_APPLE_JWKS_TIMEOUT_MS": "5000",
    "EMBER_APPLE_JWKS_COOLDOWN_MS": "30000",
    "EMBER_APPLE_JWKS_CACHE_MAX_AGE_MS": "600000",
    "EMBER_V2_DURABLE_TURN_QUEUE_NAME": "ember-v2-staging-durable-turn",
    "EMBER_V2_DURABLE_TURN_DLQ_NAME": "ember-v2-staging-durable-turn-dlq",
    "EMBER_V2_AGENT_TASK_QUEUE_NAME": "ember-v2-staging-agent-task",
    "EMBER_V2_AGENT_TASK_DLQ_NAME": "ember-v2-staging-agent-task-dlq",
  },
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_HEAD", "class_name": "AgentHeadDO" },
      { "name": "GLOBAL_BUDGET", "class_name": "GlobalBudgetDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentHeadDO", "GlobalBudgetDO"] }],
  "d1_databases": [
    {
      "binding": "D1_RECOVERY",
      "database_name": "ember-v2-staging-recovery",
      "database_id": "36f975f7-c79d-4559-9729-93091d811236",
      "migrations_dir": "../../packages/runtime-v2/migrations",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "DURABLE_TURN_QUEUE", "queue": "ember-v2-staging-durable-turn" },
      { "binding": "AGENT_TASK_QUEUE", "queue": "ember-v2-staging-agent-task" },
    ],
    "consumers": [
      {
        "queue": "ember-v2-staging-durable-turn",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "max_concurrency": 4,
        "dead_letter_queue": "ember-v2-staging-durable-turn-dlq",
      },
      {
        "queue": "ember-v2-staging-agent-task",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "max_concurrency": 2,
        "dead_letter_queue": "ember-v2-staging-agent-task-dlq",
      },
      {
        "queue": "ember-v2-staging-durable-turn-dlq",
        "max_batch_size": 10,
        "max_retries": 1,
      },
      {
        "queue": "ember-v2-staging-agent-task-dlq",
        "max_batch_size": 10,
        "max_retries": 1,
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
}
