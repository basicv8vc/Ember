{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Isolated V2 staging configuration for local dry-run validation and post-approval rollout.
  // Do NOT deploy without explicit CTO/Owner approval and provisioned D1/Queue resources.
  "name": "ember-v2-staging",
  "main": "src/local-v2/runtime-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "EMBER_ENV": "v2-staging",
    "EMBER_MODEL_MODE": "fake",
    "EMBER_V2_STAGING_ISOLATED": "true",
  },
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_HEAD", "class_name": "AgentHeadDO" },
      { "name": "GLOBAL_BUDGET", "class_name": "GlobalBudgetDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentHeadDO", "GlobalBudgetDO"] }],
  "d1_databases": [
    {
      "binding": "D1_RECOVERY",
      "database_name": "ember-v2-staging-recovery",
      // Explicit unprovisioned placeholder; preflight blocks live deploy until provisioned.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/runtime-v2/migrations",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "DURABLE_TURN_QUEUE", "queue": "ember-v2-staging-durable-turn" },
      { "binding": "AGENT_TASK_QUEUE", "queue": "ember-v2-staging-agent-task" },
    ],
    "consumers": [
      {
        "queue": "ember-v2-staging-durable-turn",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "max_concurrency": 4,
        "dead_letter_queue": "ember-v2-staging-durable-turn-dlq",
      },
      {
        "queue": "ember-v2-staging-agent-task",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "max_concurrency": 2,
        "dead_letter_queue": "ember-v2-staging-agent-task-dlq",
      },
      {
        "queue": "ember-v2-staging-durable-turn-dlq",
        "max_batch_size": 10,
        "max_retries": 1,
      },
      {
        "queue": "ember-v2-staging-agent-task-dlq",
        "max_batch_size": 10,
        "max_retries": 1,
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
}
