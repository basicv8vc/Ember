{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ember-daytona-smoke-staging",
  "main": "src/daytona-smoke-worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 },
  "queues": {
    "producers": [
      {
        "binding": "DAYTONA_SMOKE_QUEUE",
        "queue": "ember-staging-daytona-smoke",
      },
    ],
    "consumers": [
      {
        "queue": "ember-staging-daytona-smoke",
        "max_batch_size": 1,
        "max_retries": 0,
        "max_concurrency": 1,
      },
    ],
  },
  "vars": {
    "EMBER_ENV": "staging",
    "EMBER_DAYTONA_SMOKE_QUEUE_NAME": "ember-staging-daytona-smoke",
  },
}
