      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection interrupted. The task may still be in progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中断。任务可能仍在进行中。"
          }
        }
      }
    },
    "onboarding.brand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ember"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ember"
          }
        }
      }
    },
    "onboarding.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand work to Ember. See what happens next."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把事情交给 Ember，也能知道它进行到哪儿了。"
          }
        }
      }
    },
    "onboarding.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give Ember one concrete task. Follow its reported progress and review the outcome when it is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交代一件具体任务，查看真实报告的进展，并在成果可用时进行确认。"
          }
        }
      }
    },
    "onboarding.promise_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clear promise"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确的承诺"
          }
        }
      }
    },
    "onboarding.promise_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the task you want done."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明你希望完成的任务。"
          }
        }
      }
    },
    "onboarding.progress_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续可见的进展"
          }
        }
      }
    },
    "onboarding.progress_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow task updates. No estimated percentage is shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看任务报告的更新，不显示估算百分比。"
          }
        }
      }
    },
    "onboarding.outcome_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reviewable outcome"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可查看的成果"
          }
        }
      }
    },
    "onboarding.outcome_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review an outcome only when one is actually available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有成果确实可用时才会展示。"
          }
        }
      }
    },
    "onboarding.cloud_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud processing details are pending review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端处理说明仍待审核"
          }
        }
      }
    },
    "onboarding.cloud_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When cloud tasks are available, task text would be processed by Ember’s cloud service. Storage, model-training, and deletion terms are not yet confirmed. This mock screen sends no text and does not request consent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端任务开放后，任务文本会由 Ember 云端处理。存储、模型训练用途和删除规则尚未确认。此模拟页面不会发送文本，也不会请求授权。"
          }
        }
      }
    },
    "onboarding.demo_action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View the mock demo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看模拟演示"
          }
        }
      }
    },
    "onboarding.signin_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in and real task processing are not available in this mock experience."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模拟体验不提供登录或真实任务处理。"
          }
        }
      }
    },
    "tasks.error.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Task sync unavailable" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "任务同步暂不可用" } }
      }
    },
    "tasks.endpoint_unavailable.title": {
