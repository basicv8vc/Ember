    "mock_only.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOCK ONLY"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOCK ONLY · 模拟演示"
          }
        }
      }
    },
    "mock_only.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a simulated demo. No real cloud task or AI execution occurs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是模拟演示，不会执行真实云端任务或 AI 处理。"
          }
        }
      }
    },
    "composer.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should Ember take care of?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你希望 Ember 处理什么？"
          }
        }
      }
    },
    "composer.supporting_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe one task and the outcome you need."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述一件具体任务，以及你需要的结果。"
          }
        }
      }
    },
    "composer.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add task details…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入任务内容…"
          }
        }
      }
    },
    "composer.local_only_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mock only — submitting creates a simulated task; no real cloud or AI processing occurs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为模拟：提交会创建模拟任务，不会进行真实云端或 AI 处理。"
          }
        }
      }
    },
    "composer.submitting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
