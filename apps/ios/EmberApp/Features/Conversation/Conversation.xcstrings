{
  "sourceLanguage" : "en",
  "strings" : {
    "conversation.composer.accessibility" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Message Ember" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发送消息给 Ember" } }
      }
    },
    "conversation.composer.local_note" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your message stays in this local demo." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "消息仅保留在本地演示中。" } }
      }
    },
    "conversation.composer.cloud_note" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sent messages are saved in your Ember Cloud conversation." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已发送的消息会保存在 Ember 云端对话中。" } }
      }
    },
    "conversation.composer.placeholder" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Message Ember…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "给 Ember 发消息…" } }
      }
