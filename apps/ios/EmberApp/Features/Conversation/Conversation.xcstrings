    "conversation.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring a question, a thought, or something you want to work through. You can keep the conversation going here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带来一个问题、一点想法，或正在思考的事情。你可以在这里继续聊下去。"
          }
        }
      }
    },
    "conversation.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’m here with you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我在这里陪你聊。"
          }
        }
      }
    },
    "conversation.error.recoverable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The MOCK reply could not be prepared. Your message is still here; you can try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条模拟回复暂时无法准备。你的消息仍在，可以重试。"
          }
        }
      }
    },
    "conversation.error.load": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOCK ONLY · The local conversation could not be loaded. Retry to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOCK ONLY · 本地对话暂时无法加载，请重试。"
          }
        }
      }
    },
    "conversation.header.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal AI partner"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的个人 AI 伙伴"
          }
        }
      }
    },
