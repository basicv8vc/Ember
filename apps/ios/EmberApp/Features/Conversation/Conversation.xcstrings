    "conversation.message.you": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你"
          }
        }
      }
    },
    "conversation.mock_reply.default": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOCK reply: We can take this one step at a time. What feels most useful to start with?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟回复：我们可以一步一步来。你觉得从哪里开始最有帮助？"
          }
        }
      }
    },
    "conversation.mock_reply.notes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOCK reply: I can help shape those notes into a clear next step, then we can refine it together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟回复：我可以帮你把这些笔记整理成清晰的下一步，然后我们再一起完善。"
          }
        }
      }
    },
    "conversation.mock_reply.plan": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOCK reply: Let’s make the plan manageable: choose one outcome, one small next step, and when you want to revisit it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟回复：让计划轻一些：先选定一个结果、一个小步骤，以及你想回头检查的时间。"
          }
        }
      }
    },
    "conversation.prompt.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills the message box. It will not send until you choose Send."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填入输入框；只有你点击发送后才会发出。"
          }
        }
      }
    },
    "conversation.prompt.notes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help me turn a note into a clear next step."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我把一段笔记整理成清晰的下一步。"
          }
        }
      }
    },
    "conversation.prompt.plan": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help me make a simple plan for my day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我为今天安排一个简单的计划。"
          }
        }
      }
    },
    "conversation.prompt.reflect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help me think something through."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陪我把一件事想清楚。"
          }
        }
      }
    },
