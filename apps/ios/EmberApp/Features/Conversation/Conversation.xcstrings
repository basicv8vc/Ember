    "conversation.reply.stop_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this local MOCK reply stopped. No Ember task was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅停止了这条本地模拟回复，没有取消任何 Ember 任务。"
