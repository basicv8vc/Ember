    "conversation.live.send_unknown_ack_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking whether your message was sent. It hasn't been marked as failed and won't be sent twice — tap Try again to check status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在确认消息是否已发送。系统尚未判定失败，也不会重复发送；请点击“重试”核对发送状态。"
          }
        }
      }
    },
    "conversation.live.send_unknown_ack_status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery is not confirmed yet. Check the message status before trying to send again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送结果尚未确认，请先检查消息状态，不要重复发送。"
          }
        }
