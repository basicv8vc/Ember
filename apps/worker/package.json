{
  "name": "@ember/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./b1/model-turn-responder": {
      "types": "./dist/b1/model-turn-responder.d.ts",
      "default": "./dist/b1/model-turn-responder.js"
    },
    "./notes-task-handler": {
      "types": "./dist/notes-task-handler.d.ts",
      "default": "./dist/notes-task-handler.js"
    },
    "./b3/python-agent-executor": {
      "types": "./dist/b3/python-agent-executor.d.ts",
      "default": "./dist/b3/python-agent-executor.js"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/index.js",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@ember/connectors": "workspace:*",
    "@ember/contracts": "workspace:*",
    "@ember/credentials": "workspace:*",
    "@ember/domain": "workspace:*",
    "@ember/execution": "workspace:*",
    "@ember/model-gateway": "workspace:*",
    "@ember/postgres": "workspace:*",
    "zod": "4.6.7"
  }
}
