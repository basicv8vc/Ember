    {
      "metric": "ack",
      "formula": "T_ack = t_http_ack - t_req_start = T_edge_auth + T_budget_reserve + T_do_prepare (+ T_d1_register_confirm if uncovered)",
      "targetDescription": "ADR-0006 provisional near-region Durable ACK P95 target <= 250 ms",
      "includesModelIo": false
    },
    {
      "metric": "runtime_overhead",
      "formula": "T_runtime = T_edge_auth + T_budget_reserve + T_do_prepare (+ T_d1_reg if uncovered) + T_budget_authorize + T_do_mark_attempt_sent + T_do_commit_sync + T_budget_settle + T_stream_cpu",
      "targetDescription": "ADR-0006 provisional near-region Runtime Overhead P95 target <= 200 ms (excl. model/provider)",
      "includesModelIo": false
    },
    {
      "metric": "streaming_cpu",
      "formula": "C_stream = (process.cpuUsage().user + process.cpuUsage().system) delta in ms (Node/V8 synthetic proxy)",
      "targetDescription": "Workers Standard bills active CPU ms ($0.02/M ms), not idle network wait wall time",
      "includesModelIo": false
    },
    {
      "metric": "global_budget_check",
      "formula": "T_budget = T_global_budget_reserve + T_global_budget_authorize (subset of T_runtime)",
      "targetDescription": "ADR-0006 provisional M1 target <= 50 ms near-region P95 inside <= 200 ms Runtime Overhead",
      "includesModelIo": false
    }
  ],
