# Cloudflare Tunnel origin. Public TLS terminates at Cloudflare; cloudflared reaches this
# listener over the local Docker bridge. No Caddy listener is published to a public host
# address, and this block has no ACME or local certificate behavior.
{
	admin off
	auto_https off
}

http://{$EMBER_STAGING_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	request_body {
		max_size 2MB
	}

	log {
		output stdout
		format json
	}

	reverse_proxy api:8787 {
		header_up X-Forwarded-Proto https
		# Keep client credentials and bodies out of proxy logs. The origin only receives a
		# host name and the scheme assertion required by the API.
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
		health_uri /healthz
		health_interval 15s
		health_timeout 3s
	}
}
