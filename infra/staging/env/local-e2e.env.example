# Full-lifecycle HTTP E2E profile (acceptance only — never a deployment).
#
# This profile exists for one reason: the Worker's B2 guard refuses
# `EMBER_MODEL_EXECUTION=fake` under `NODE_ENV=staging` (a process that claims to be a live
# deployment must never serve simulated replies), so the end-to-end acceptance run — sign
# in, conversation, message, Worker turn, persisted Assistant reply, iOS read path — needs
# a run where the deterministic Fake Model is legal. Everything else is identical to
# `local-verify.env.example`: same images, same compose topology, same database rules, same
# refusal of every development authentication path.
#
# Differences from local-verify, and only these:
#
#   * NODE_ENV=test / EMBER_ENV=test — the markers the B2 Fake Model guard requires;
#   * EMBER_MODEL_EXECUTION=fake — the deterministic, zero-egress, zero-cost adapter;
#   * isolated volume set and non-conflicting ports, so it can run beside another stack.
#
# Sign-in still cannot happen through the main stack's public listener: the dev provider is
# gated on a loopback listener by design (R-9) and Apple verification needs a real device
# token. The harness therefore signs in through the real `POST /v1/auth/session` endpoint on
# a loopback one-shot container and uses the issued session token for every call through the
# TLS edge. See docs/CLOUD-STAGING-VERIFICATION.md.
#
#   cp infra/staging/env/local-e2e.env.example /tmp/ember-staging-e2e.env
#   # replace the password, then:
#   chmod 600 /tmp/ember-staging-e2e.env
#   infra/staging/scripts/cloud-e2e.sh --env-file /tmp/ember-staging-e2e.env

NODE_ENV=test
EMBER_ENV=test
EMBER_LOG_LEVEL=info

DATABASE_URL=postgres://ember:REPLACE_WITH_LOCAL_THROWAWAY_PASSWORD@postgres:5432/ember
EMBER_DB_POOL_MAX=10
EMBER_POSTGRES_DB=ember
EMBER_POSTGRES_USER=ember
EMBER_POSTGRES_PASSWORD_FILE=/tmp/ember-staging-e2e-secrets/postgres_password

EMBER_HOST=0.0.0.0
EMBER_PORT=8787
EMBER_ALLOW_NON_LOOPBACK_BIND=true
EMBER_API_HOST_PORT=18788
EMBER_APPLE_BUNDLE_ID=com.basicv8vc.ember
EMBER_API_BLOB_ROOT=/var/lib/ember/blobs
EMBER_DEV_PROVIDER_ENABLED=false
EMBER_DEV_PROVIDER_ISOLATED=false

EMBER_WORKER_MODE=poll
EMBER_WORKER_SIMULATED_EXECUTION=local-only
EMBER_WORKER_ID=ember-staging-e2e-worker
EMBER_WORKER_BLOB_ROOT=/var/lib/ember/blobs
EMBER_WORKER_INTERVAL_MS=500
EMBER_WORKER_CONCURRENCY=2
EMBER_B1_FAKE_RESPONDER_ENABLED=false
EMBER_SCHEDULER_ENABLED=false

# B2 Model Execution: the deterministic Fake Model. Labelled `ember-fake-model-gateway-1`
# and marked `simulated: true` in every published reply; zero egress, zero cost. `real`
# stays refused in every profile.
EMBER_MODEL_EXECUTION=fake

EMBER_STAGING_HOSTNAME=localhost
EMBER_ACME_EMAIL=staging-ops@ember.invalid
EMBER_CADDY_CONFIG=Caddyfile.internal
EMBER_EDGE_BIND=127.0.0.1
EMBER_EDGE_HTTP_PORT=18180
EMBER_EDGE_HTTPS_PORT=18444

# Volume namespace: placeholder only. `cloud-e2e.mjs` generates a unique
# `ember-e2e-<run>` prefix per execution and force-injects it (shell env wins over
# `--env-file`), so this file can never point a run at staging/production volumes.
# preflight --mode=e2e refuses any value outside `ember-e2e-*`; hand-run `docker
# compose` against this file is likewise confined to the ember-e2e-* namespace.
EMBER_VOLUME_PREFIX=ember-e2e-manual

EMBER_POSTGRES_IMAGE=postgres:17.6-alpine
EMBER_CADDY_IMAGE=caddy:2.10.2-alpine
EMBER_NODE_IMAGE=node:24.22.1-bookworm-slim
EMBER_PNPM_VERSION=12.15.0
EMBER_IMAGE_VERSION=local-e2e
EMBER_API_IMAGE=ember-api:local-e2e
EMBER_WORKER_IMAGE=ember-worker:local-e2e
