# Local verification profile for the staging stack.
#
# This is the staging configuration with three differences, and only three:
#
#   * EMBER_STAGING_HOSTNAME=localhost + the internal-CA Caddyfile, because there is no
#     public DNS name before the cloud account is authorised;
#   * non-privileged edge ports (18080/18443) so nothing needs root;
#   * a throwaway database password.
#
# Every authentication, credential, worker-mode and database rule is identical to staging —
# preflight runs in `--mode=local`, which relaxes the hostname check only. That is what makes
# the local run evidence about the staging configuration rather than about a different one.
#
#   cp infra/staging/env/local-verify.env.example /tmp/ember-staging-verify.env
#   # replace the password, then:
#   chmod 600 /tmp/ember-staging-verify.env
#   infra/staging/scripts/deploy.sh --env-file /tmp/ember-staging-verify.env
#   EMBER_STAGING_ENV_FILE=/tmp/ember-staging-verify.env \
#     infra/staging/scripts/preflight.sh --env-file /tmp/ember-staging-verify.env --mode=local

NODE_ENV=staging
EMBER_ENV=ci
EMBER_LOG_LEVEL=info

DATABASE_URL=postgres://ember:REPLACE_WITH_LOCAL_THROWAWAY_PASSWORD@postgres:5432/ember
EMBER_DB_POOL_MAX=10
EMBER_POSTGRES_DB=ember
EMBER_POSTGRES_USER=ember
EMBER_POSTGRES_PASSWORD_FILE=/tmp/ember-staging-verify-secrets/postgres_password

EMBER_HOST=0.0.0.0
EMBER_PORT=8787
EMBER_ALLOW_NON_LOOPBACK_BIND=true
EMBER_API_HOST_PORT=18787
EMBER_APPLE_BUNDLE_ID=com.ember.mobile
EMBER_API_BLOB_ROOT=/var/lib/ember/blobs
EMBER_DEV_PROVIDER_ENABLED=false
EMBER_DEV_PROVIDER_ISOLATED=false

EMBER_WORKER_MODE=poll
EMBER_WORKER_SIMULATED_EXECUTION=local-only
EMBER_WORKER_ID=ember-staging-verify-worker
EMBER_WORKER_BLOB_ROOT=/var/lib/ember/blobs
EMBER_WORKER_INTERVAL_MS=1000
EMBER_WORKER_CONCURRENCY=2
EMBER_B1_FAKE_RESPONDER_ENABLED=false
EMBER_SCHEDULER_ENABLED=false

EMBER_STAGING_HOSTNAME=localhost
EMBER_ACME_EMAIL=staging-ops@ember.invalid
EMBER_CADDY_CONFIG=Caddyfile.internal
EMBER_EDGE_BIND=127.0.0.1
EMBER_EDGE_HTTP_PORT=18080
EMBER_EDGE_HTTPS_PORT=18443

EMBER_POSTGRES_IMAGE=postgres:17.6-alpine
EMBER_CADDY_IMAGE=caddy:2.10.2-alpine
EMBER_NODE_IMAGE=node:24.22.1-bookworm-slim
EMBER_PNPM_VERSION=12.15.0
EMBER_IMAGE_VERSION=local-verify
EMBER_API_IMAGE=ember-api:local-verify
EMBER_WORKER_IMAGE=ember-worker:local-verify
