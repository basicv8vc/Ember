# Ember Cloud Staging — environment file template.
#
# This file contains NO secrets. Copy it to `/etc/ember/staging.env`, replace every
# placeholder, and keep the resulting file mode 0600. The Cloudflare tunnel token is stored
# separately at EMBER_CLOUDFLARE_TUNNEL_TOKEN_FILE.
#
# Every value below is validated by `infra/staging/scripts/preflight.sh` before any
# container starts. A value that weakens authentication fails the guard instead of being
# silently accepted.
#
# Two facts about the current runtime that shape this file:
#
#   1. `EMBER_ENV=staging` is the formal shared-deployment marker (runtime staging
#      support landed with the deployment-classification fix, PR #126): the process
#      classifies itself as a staging deployment and fails the development-only paths
#      closed in its own code — the dev sign-in provider and the legacy dev bearer
#      tokens are denied by classification, not only by deployment tooling.
#      `preflight.sh` additionally forbids the legacy dev bearer tokens outright.
#      See docs/CLOUD-STAGING-SECURITY.md (R-1, R-2).
#
#   2. Model execution is owned by B2's Model Gateway and is OFF here. `EMBER_MODEL_EXECUTION`
#      defaults to `disabled` and staging pins it explicitly: `real` is refused unless a
#      reviewed approval, an invoice-verified rate row and a provider credential are all in
#      place (none are), and `fake` is refused outright under staging markers — a process
#      that claims to be a live deployment must never serve simulated replies. There is no
#      model provider credential in this file, and there must not be one.

# ---------------------------------------------------------------------------------------
# Runtime identity
# ---------------------------------------------------------------------------------------
# `staging` (not production) is required: the API refuses to load with NODE_ENV=production
# while development credentials share the composition root.
NODE_ENV=staging
# The formal shared-deployment marker. `ci` is development-class and must never label a
# shared deployment: the runtime classifies every development surface off this value.
EMBER_ENV=staging
EMBER_LOG_LEVEL=info

# ---------------------------------------------------------------------------------------
# Database (private network only — never a public endpoint, never Shua's database)
# ---------------------------------------------------------------------------------------
# Host `postgres` is the compose service on the internal `db` network.
# The password must be URL-safe (A-Za-z0-9_-); preflight rejects percent-encoding and `$`.
DATABASE_URL=postgres://ember:REPLACE_WITH_GENERATED_PASSWORD@postgres:5432/ember
EMBER_DB_POOL_MAX=10
EMBER_DB_CONNECT_TIMEOUT_MS=5000
EMBER_DB_STATEMENT_TIMEOUT_MS=10000

EMBER_POSTGRES_DB=ember
EMBER_POSTGRES_USER=ember
# Compose reads this path on the host; the file must be 0600 and hold only the password.
EMBER_POSTGRES_PASSWORD_FILE=/etc/ember/secrets/postgres_password

# ---------------------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------------------
# 0.0.0.0 inside the container is required for the edge proxy to reach it. The only
# published mapping is 127.0.0.1:${EMBER_API_HOST_PORT} on the host.
EMBER_HOST=0.0.0.0
EMBER_PORT=8787
EMBER_ALLOW_NON_LOOPBACK_BIND=true
EMBER_API_HOST_PORT=8787

# Audience of every accepted Apple identity token. Must be the real iOS bundle id.
EMBER_APPLE_BUNDLE_ID=com.basicv8vc.ember

# Shared artifact blob root (same named volume as the Worker).
EMBER_API_BLOB_ROOT=/var/lib/ember/blobs

# Development sign-in must stay off. These two lines exist so that a copied local
# environment cannot silently enable it; preflight also rejects `true`.
EMBER_DEV_PROVIDER_ENABLED=false
EMBER_DEV_PROVIDER_ISOLATED=false

# ---------------------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------------------
# Shared deployments run `reaper-only` (lease reaping, the commitment scheduler, and the
# B2 turn responder when model execution is on). The task poll lane requires the
# deterministic-executor opt-in, and the runtime refuses that in staging/production — it
# stays a local/test capability until P0B-06 provides durable execution results (#126).
EMBER_WORKER_MODE=reaper-only
EMBER_WORKER_SIMULATED_EXECUTION=disabled
EMBER_WORKER_ID=ember-staging-worker-1
EMBER_WORKER_BLOB_ROOT=/var/lib/ember/blobs
EMBER_WORKER_INTERVAL_MS=2000
EMBER_WORKER_ERROR_BACKOFF_MS=1000
EMBER_WORKER_CONCURRENCY=4
EMBER_WORKER_LEASE_MS=30000
EMBER_WORKER_HEARTBEAT_MS=10000
EMBER_WORKER_RETRY_BASE_MS=1000
EMBER_WORKER_RETRY_CAP_MS=30000
EMBER_WORKER_REAPER_BATCH=50

# Simulated chat replies are a local/test capability and stay off in staging. Until the
# Model Gateway lands, a submitted Turn remains durably pending — that is the expected
# staging behaviour and it is what the restart test asserts.
EMBER_B1_FAKE_RESPONDER_ENABLED=false

# Autonomous scheduler stays off until Gate 3 review.
EMBER_SCHEDULER_ENABLED=false

# Budget policy (trusted Worker configuration, never client-supplied).
EMBER_WORKER_BUDGET_POLICY_ID=p0b08b-simulated-v1
EMBER_WORKER_BUDGET_POLICY_VERSION=1
EMBER_WORKER_BUDGET_MAX_RUN_STEPS=8
EMBER_WORKER_BUDGET_MAX_RUN_UNITS=100
EMBER_WORKER_BUDGET_MAX_RUN_ELAPSED_MS=120000
EMBER_WORKER_BUDGET_MAX_TENANT_DAILY_UNITS=5000
EMBER_WORKER_BUDGET_MAX_CONCURRENT_SLOTS=8

# Sentinel admission policy: mock writes stay denied.
EMBER_WORKER_SENTINEL_POLICY_ID=sentinel-policy-default
EMBER_WORKER_SENTINEL_POLICY_VERSION=1
EMBER_WORKER_SENTINEL_ALLOW_MOCK_WRITE=false

# ---------------------------------------------------------------------------------------
# B2 Model Execution — off by default and off here
# ---------------------------------------------------------------------------------------
# The Worker starts no model turn responder at `disabled`; a submitted Turn stays durably
# pending. `real` needs the code-owned approval registry, an invoice-verified rate and a
# credential together (all absent, so it would refuse to boot — never silently downgrade).
# `fake` is a local/CI capability and is refused under NODE_ENV=staging. Preflight rejects
# `real` and any provider credential in every mode.
EMBER_MODEL_EXECUTION=disabled

# ---------------------------------------------------------------------------------------
# Edge (Caddy) and image references — compose interpolation
# ---------------------------------------------------------------------------------------
# Public hostname for the API. It must be explicitly approved by the domain owner and
# configured in the Cloudflare dashboard before the tunnel can serve traffic.
EMBER_STAGING_HOSTNAME=staging.example.com
# The public certificate terminates at Cloudflare. Caddy's tunnel listener is HTTP only on
# the private Docker network; loopback-only host mappings are retained for local debugging.
EMBER_CADDY_CONFIG=Caddyfile.tunnel
EMBER_EDGE_BIND=127.0.0.1
EMBER_EDGE_HTTP_PORT=18080
EMBER_EDGE_HTTPS_PORT=18443
EMBER_CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/ember/secrets/cloudflare_tunnel_token

EMBER_POSTGRES_IMAGE=postgres:17.6-alpine
EMBER_CADDY_IMAGE=caddy:2.10.2-alpine
EMBER_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.7
EMBER_NODE_IMAGE=node:24.22.1-bookworm-slim
EMBER_PNPM_VERSION=12.15.0

# Immutable per-release tags, e.g. ember-api:git-c6c9c3d-20261106.
EMBER_IMAGE_VERSION=dev
EMBER_API_IMAGE=ember-api:staging-local
EMBER_WORKER_IMAGE=ember-worker:staging-local
