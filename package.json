{
  "name": "ember",
  "version": "0.0.0",
  "private": true,
  "description": "Ember — Personal Agent Platform (V2 Cloudflare-native runtime)",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev:v2:local": "pnpm --filter @ember/api dev:worker",
    "build:v2:staging": "pnpm --filter @ember/api build:v2-staging",
    "deploy:v2:staging": "pnpm --filter @ember/api deploy:v2-staging",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "bench:local": "node --env-file-if-exists=.env.local --import tsx apps/benchmark/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@hono/node-server": "2.1.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "hono": "4.13.14",
    "jose": "6.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
