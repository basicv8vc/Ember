{
  "name": "@ember/postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./b1-worker": {
      "types": "./dist/b1-worker.d.ts",
      "default": "./dist/b1-worker.js"
    },
    "./b2-worker": {
      "types": "./dist/b2-worker.d.ts",
      "default": "./dist/b2-worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@ember/contracts": "workspace:*",
    "@ember/domain": "workspace:*",
    "@ember/execution": "workspace:*",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
