{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ember/contracts": ["./packages/contracts/src/index.ts"],
      "@ember/domain": ["./packages/domain/src/index.ts"],
      "@ember/model-gateway": ["./packages/model-gateway/src/index.ts"],
      "@ember/runtime-v2": ["./packages/runtime-v2/src/index.ts"],
      "@ember/runtime-v2/global-budget-do": ["./packages/runtime-v2/src/global-budget/worker.ts"],
      "@ember/sandbox-daytona": ["./packages/sandbox-daytona/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "vitest.*.ts",
    "eslint.config.js"
  ]
}
